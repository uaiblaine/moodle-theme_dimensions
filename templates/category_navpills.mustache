{{!
    @template theme_dimensions/category_navpills

    The category's secondary navigation as a row of nav pills in a capsule
    (the fleet Design System's nav-pill.md), drawn by the category hero on the
    band's lower edge. The units come from the theme's key-to-group map: a
    plain unit is a link to its destination; a group is a native disclosure
    whose summary is its pill and whose menu holds one link per destination,
    each with its icon. "More", last, holds the nodes the map does not know: it
    is drawn visible when it has some and hidden and empty otherwise.

    It works without JavaScript: every link is in the page and every disclosure
    opens natively. The current destination carries aria-current="page" and
    the dot, on the row or in a menu; the pill of the group that holds it takes
    the selected look, the dot and aria-current too. The dot, the chevron and every icon are
    decorative (the pix helper with no alternative text). Every destination
    carries its node's key as data-key; a group carries its own as data-group.

    A plain pill's icon is hidden on the row: it is shown when a client moves
    the pill into a menu, where every item has one.

    Context variables required for this template:
    * label - The nav's accessible name.
    * uniqid - The row's id; every menu's id starts with it.
    * units - The plain units and the groups, in the row's order: isgroup; a
      plain unit's key, text, url, current and icon (key, component); a group's
      key, name, current, menuid and items (destinations of a plain unit's
      shape).
    * more - The More unit, of a group's shape, with hasitems.

    Example context (json):
    {
        "label": "Category navigation",
        "uniqid": "dim-navpills-6740a1b2c3d4e",
        "units": [
            {
                "isgroup": false,
                "key": "categorymain",
                "text": "Category",
                "url": "https://example.com/course/index.php?categoryid=7",
                "current": true,
                "icon": {"key": "i/link", "component": "core"}
            },
            {
                "isgroup": true,
                "key": "settings",
                "name": "Settings",
                "current": true,
                "menuid": "dim-navpills-6740a1b2c3d4e-settings",
                "items": [
                    {
                        "key": "categoryappearance",
                        "text": "Category appearance",
                        "url": "https://example.com/theme/dimensions/categoryhero.php?id=7",
                        "current": true,
                        "icon": {"key": "i/edit", "component": "core"}
                    },
                    {
                        "key": "edit",
                        "text": "Settings",
                        "url": "https://example.com/course/editcategory.php?id=7",
                        "current": false,
                        "icon": {"key": "i/edit", "component": "core"}
                    }
                ]
            }
        ],
        "more": {
            "key": "other",
            "name": "More",
            "current": false,
            "menuid": "dim-navpills-6740a1b2c3d4e-other",
            "hasitems": true,
            "items": [
                {
                    "key": "insights",
                    "text": "Insights",
                    "url": "https://example.com/report/insights/insights.php?contextid=31",
                    "current": false,
                    "icon": {"key": "i/report", "component": "core"}
                }
            ]
        }
    }
}}
<nav class="dim-navpills" id="{{uniqid}}" aria-label="{{label}}" data-region="dim-navpills">
    {{#units}}
    {{^isgroup}}
    <a class="dim-navpill" href="{{url}}" data-key="{{key}}"{{#current}} aria-current="page"{{/current}}><span class="dim-navpill__icon">{{#pix}} {{icon.key}}, {{icon.component}} {{/pix}}</span>{{#current}}<span class="dim-navpill__dot" aria-hidden="true"></span>{{/current}}<span class="dim-navpill__label">{{text}}</span></a>
    {{/isgroup}}
    {{#isgroup}}
    <details class="dim-navpill-group" data-group="{{key}}">
        <summary class="dim-navpill{{#current}} is-selected{{/current}}"{{#current}} aria-current="page"{{/current}}>{{#current}}<span class="dim-navpill__dot" aria-hidden="true"></span>{{/current}}<span class="dim-navpill__label">{{name}}</span><span class="dim-navpill__chevron">{{#pix}} t/expanded, core {{/pix}}</span></summary>
        <div class="dim-navpill-menu" id="{{menuid}}">
            {{#items}}
            <a class="dim-navpill-menu__item" href="{{url}}" data-key="{{key}}"{{#current}} aria-current="page"{{/current}}>{{#pix}} {{icon.key}}, {{icon.component}} {{/pix}}<span class="dim-navpill-menu__label">{{text}}</span>{{#current}}<span class="dim-navpill__dot" aria-hidden="true"></span>{{/current}}</a>
            {{/items}}
        </div>
    </details>
    {{/isgroup}}
    {{/units}}
    {{#more}}
    <details class="dim-navpill-group dim-navpill-group--more" data-group="{{key}}" data-region="dim-navpills-more"{{^hasitems}} hidden{{/hasitems}}>
        <summary class="dim-navpill{{#current}} is-selected{{/current}}"{{#current}} aria-current="page"{{/current}}>{{#current}}<span class="dim-navpill__dot" aria-hidden="true"></span>{{/current}}<span class="dim-navpill__label">{{name}}</span><span class="dim-navpill__chevron">{{#pix}} t/expanded, core {{/pix}}</span></summary>
        <div class="dim-navpill-menu" id="{{menuid}}">
            {{#items}}
            <a class="dim-navpill-menu__item" href="{{url}}" data-key="{{key}}"{{#current}} aria-current="page"{{/current}}>{{#pix}} {{icon.key}}, {{icon.component}} {{/pix}}<span class="dim-navpill-menu__label">{{text}}</span>{{#current}}<span class="dim-navpill__dot" aria-hidden="true"></span>{{/current}}</a>
            {{/items}}
        </div>
    </details>
    {{/more}}
</nav>
