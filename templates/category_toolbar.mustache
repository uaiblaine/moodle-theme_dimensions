        "viewlabel": "View",
        "showaslabel": "Show as",
        "views": [
            {"value": "list", "label": "List", "current": false, "icon": "fa-list"},
            {"value": "cards", "label": "Cards", "current": true, "icon": "fa-border-all"}
        ],
