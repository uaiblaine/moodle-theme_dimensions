        "hasfilters": true,
        "chips": [
            {"param": "cf_12", "label": "Online", "url": "https://example.com/course/index.php?categoryid=7&q=rescue&chip=pending&from=2026-09-17&to=2026-09-24", "removelabel": "Remove filter", "isperiod": false},
            {"param": "period", "label": "17 September 2026 to 24 September 2026", "url": "https://example.com/course/index.php?categoryid=7&q=rescue&chip=pending&cf_12=1", "removelabel": "Remove filter", "isperiod": true},
            {"param": "chip", "label": "Under review", "url": "https://example.com/course/index.php?categoryid=7&q=rescue&cf_12=1&from=2026-09-17&to=2026-09-24", "removelabel": "Remove filter", "isperiod": false}
        ],
        "haschips": true,
        "clearall": true,
        "clearurl": "https://example.com/course/index.php?categoryid=7",
        "clearlabel": "Clear all",
        "manageactions": "<div class=\"action-menu\"><a href=\"#\">Manage courses</a></div>",
        "hasmanageactions": true
