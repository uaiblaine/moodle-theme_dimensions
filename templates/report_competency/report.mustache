{{!
    @template report_competency/report

    The competency breakdown report of one participant in a course, overridden by Dimensions.

    Mirrors report_competency/report of Moodle 5.3 (2026100500), report/competency/templates/report.mustache.
    Re-diff it against that file on every core upgrade. report_competency/grading_popup re-renders it
    through core/templates after every rating and replaces the root element with the answer, so the
    root must stay the region it looks for.

    Kept from core, because report_competency/grading_popup and tool_lp/competencydialogue read them:
    the root's data-region="competency-breakdown-report" with data-courseid, data-userid and
    data-moduleid (read by the refresh); each rating cell's data-user-competency="true", data-userid,
    data-competencyid and data-courseid (the popup's click target and its arguments); each
    competency's link with data-action="competency-dialogue" and data-id, and the em's data-id;
    data-region="configurecoursecompetencies"; both pieces of JavaScript. Kept for Behat
    (report_competency's "breakdown" and "breakdown rating" selectors): a table under the root, one
    row per competency, the competency's link in the first cell and the rating in the second td,
    inside a link titled "User competency summary" (report_competency/user_competency_summary). The
    shortname keeps core's triple stash, the idnumber its double stash.
    Changed: the two notes about pushing ratings are info callouts with an icon; the table is the
    theme's (dim-comp-table), with a head and a body, a caption in place of core's summary element
    (which a table cannot hold), and no column cap; the rating cell does not paint a proficient
    competency green (core's alert-success, colour alone): it holds pills that say rated, proficient,
    not proficient or not rated in words, each with an icon.

    Context variables required for this template:
    * course - id
    * user - id
    * moduleid
    * pushratingstouserplans - boolean
    * usercompetencies - array of competency (a competency_summary record) and usercompetencycourse
      (competencyid, grade, gradename, proficiency)

    Example context (json):
    {
        "course": {"id": 2},
        "user": {"id": 3},
        "moduleid": 0,
        "pushratingstouserplans": true,
        "usercompetencies": [
            {
                "competency": {
                    "competency": {"id": 1, "shortname": "Communicate clearly", "idnumber": "COMM-1"}
                },
                "usercompetencycourse": {"competencyid": 1, "grade": 2, "gradename": "Competent", "proficiency": true}
            },
            {
                "competency": {
                    "competency": {"id": 3, "shortname": "Listen actively", "idnumber": "COMM-2"}
                },
                "usercompetencycourse": {"competencyid": 3, "grade": null, "gradename": "-", "proficiency": null}
            }
        ]
    }
}}
<div data-region="competency-breakdown-report" class="dim-comp-report" data-courseid="{{course.id}}" data-userid="{{user.id}}" data-moduleid="{{moduleid}}">
<div data-region="configurecoursecompetencies">
{{#pushratingstouserplans}}
    <p class="dim-comp-callout">
        <i class="fa-solid fa-circle-info dim-comp-callout__icon" aria-hidden="true"></i>
        <span>{{#str}}coursecompetencyratingsarepushedtouserplans, tool_lp{{/str}}</span>
    </p>
{{/pushratingstouserplans}}
{{^pushratingstouserplans}}
    <p class="dim-comp-callout">
        <i class="fa-solid fa-circle-info dim-comp-callout__icon" aria-hidden="true"></i>
        <span>{{#str}}coursecompetencyratingsarenotpushedtouserplans, tool_lp{{/str}}</span>
    </p>
{{/pushratingstouserplans}}
</div>
<div class="table-responsive">
    <table class="table dim-comp-table">
        <caption class="visually-hidden">{{#str}}coursecompetencybreakdownsummary, report_competency{{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}}competency, report_competency{{/str}}</th>
                <th scope="col">{{#str}}rating, report_competency{{/str}}</th>
            </tr>
        </thead>
        <tbody>
        {{#usercompetencies}}
        <tr>
            {{#competency}}
            <td>
                <a href="#" data-action="competency-dialogue" data-id="{{competency.id}}">
                    {{{competency.shortname}}} <em class="dim-comp-idnumber" data-id="{{competency.id}}">{{competency.idnumber}}</em>
                </a>
            </td>
            {{/competency}}
            {{#usercompetencycourse}}
            <td class="dim-comp-report__rating"
                data-user-competency="true"
                data-userid="{{user.id}}"
                data-competencyid="{{competencyid}}"
                data-courseid="{{course.id}}">
                {{> report_competency/user_competency_summary}}
            </td>
            {{/usercompetencycourse}}
        </tr>
        {{/usercompetencies}}
        </tbody>
    </table>
</div>
</div>
{{#js}}
require(['tool_lp/competencydialogue'], function(Compdialogue) {
    Compdialogue.init();
});
require(['report_competency/grading_popup'], function(Popup) {
    (new Popup('[data-region=competency-breakdown-report]', '[data-user-competency=true]'));
});
{{/js}}
