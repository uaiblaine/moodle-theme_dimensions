{{!

    @template theme_boost/primary-drawer-mobile

    This template renders the mobile version of the top navbar menu in a drawer.

    Example context (json):
    {
        "navbarcolorclasses": "navbar-dark bg-primary",
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50"
        },
        "dimensionsguest": {
            "loginurl": "https://example.com/login/index.php",
            "hassignup": true,
            "signupurl": "https://example.com/login/signup.php",
            "isguest": false
        },
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": "true"
            },
            {
                "text": "Site home",
                "url": "/",
                "isactive": "false"
            },
            {
                "text": "My courses",
                "url": "/course",
                "isactive": "false"
            }
        ]
    }
}}
{{!
    This template is a modified version of theme_boost/primary-drawer-mobile

    Modifications compared to the original template:
    * Extend the mobile primary navigation.
    * Move child node markup into its own template.
}}
{{!
    theme_dimensions: this is a copy of Boost Union's override of theme_boost/primary-drawer-mobile
    (Boost Union's templates/theme_boost/primary-drawer-mobile.mustache; the version last re-diffed is the
    snapshot primary-drawer-mobile.mustache.upstream beside this file), with three modifications:

    * A band behind the drawer's header carrying the navbar's own colour classes (navbarcolorclasses,
      the layout context key the navbar is drawn with), so every rule that paints the navbar - Boost
      Union's colour and tint, a flavour's, the dark colour mode's repaint - paints the band too. The
      drawer opens over the navbar (scss/post.scss), and its logo is the navbar's, made for that colour.

    * The visitor's "New here?" card (theme_dimensions/navbar_guest_card) at the start of the drawer's
      content, drawn from the layout context key dimensionsguest, which this theme's core renderer
      writes only while theme_dimensions\local\guestnav applies.
    * The drawer of a logged-in account (theme_dimensions/drawer_nav) in place of Boost Union's list,
      drawn from the layout context key dimensionsdrawer, which the core renderer writes only while
      theme_dimensions\local\drawernav applies. Boost Union's list below is untouched and is what
      every other session gets, the visitor's card included.

    Re-diff it against Boost Union's template on every Boost Union update and carry their changes over
    (scripts/upstream-merge.sh merges them against the snapshot): the list inside the inverted section is
    Boost Union's markup, line for line.
}}
{{< theme_boost/drawer }}
    {{$id}}theme_boost-drawers-primary{{/id}}
    {{$drawerclasses}}drawer drawer-left drawer-primary{{/drawerclasses}}
    {{$drawercloseonresize}}1{{/drawercloseonresize}}
    {{$drawerheading}}
        <span class="navbar {{navbarcolorclasses}} dimensions-drawer-band" aria-hidden="true"></span>
        <a
            href="{{#alternativelogolinkurl}}{{{alternativelogolinkurl}}}{{/alternativelogolinkurl}}{{^alternativelogolinkurl}}{{{ config.homeurl }}}{{/alternativelogolinkurl}}"
            title="{{{ sitename }}}"
            data-region="site-home-link"
            class="aabtn text-reset d-flex align-items-center h-100"
        >
            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                <span class="sitename" title="{{{ sitename }}}">{{{ sitename }}}</span>
            {{/ output.should_display_navbar_logo }}
        </a>
    {{/drawerheading}}
    {{$drawercontent}}
        {{#dimensionsguest}}{{> theme_dimensions/navbar_guest_card }}{{/dimensionsguest}}
        {{#dimensionsdrawer}}{{> theme_dimensions/drawer_nav }}{{/dimensionsdrawer}}
        {{^dimensionsdrawer}}
        <div class="list-group">
            {{#mobileprimarynav}}
                {{#haschildren}}
                    {{> theme_boost_union/primary-drawer-mobile-child }}
                {{/haschildren}}
                {{^haschildren}}
                <a href="{{{url}}}" {{#tooltip}}title="{{.}}" data-bs-toggle="tooltip"{{/tooltip}} class="{{#menuclasses}} {{.}} {{/menuclasses}} list-group-item list-group-item-action {{#isactive}}active{{/isactive}} {{#classes}}{{.}} {{/classes}}" {{#isactive}}aria-current="true"{{/isactive}} {{#attributes}}{{#name}}{{name}}="{{value}}"{{/name}} {{/attributes}}>
                    {{{text}}}
                </a>
                {{/haschildren}}
            {{/mobileprimarynav}}
        </div>
        {{/dimensionsdrawer}}
    {{/drawercontent}}
    {{$drawerstate}}show-drawer-primary{{/drawerstate}}
{{/ theme_boost/drawer}}
