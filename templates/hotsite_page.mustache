<div class="dimensions-hotsite{{#bar}} dimensions-hotsite--hasbar{{/bar}}" data-region="dimensions-hotsite" data-courseid="{{courseid}}">
    <header class="dimensions-hotsite__hero">
        {{#heroimageurl}}
            <div class="dimensions-hotsite__hero-media" style="background-image: url('{{heroimageurl}}');" aria-hidden="true"></div>
        {{/heroimageurl}}
        <div class="dimensions-hotsite__hero-content{{#hasbadges}} dimensions-hotsite__hero-content--badges{{/hasbadges}}">
            <div class="dimensions-hotsite__hero-text">
            {{#categoryname}}
                <span class="dimensions-hotsite__kicker">{{categoryname}}</span>
            {{/categoryname}}
            <h1 class="dimensions-hotsite__title">{{fullname}}</h1>
            {{#haschips}}
                <ul class="dimensions-hotsite__chips list-unstyled m-0">
                    {{#chips}}
                        <li class="dimensions-hotsite__chip">{{.}}</li>
                    {{/chips}}
                    {{#haslivechip}}
                        <li class="dimensions-hotsite__chip dimensions-hotsite__chip--live"><span class="dimensions-hotsite__livedot" aria-hidden="true"></span>{{#str}} hotsite_livechip, theme_dimensions {{/str}}</li>
                    {{/haslivechip}}
                </ul>
            {{/haschips}}
            {{#herodate}}
                <div class="dimensions-hotsite__em dimensions-hotsite__em--big">
                    <span class="dimensions-hotsite__em-main">{{datebig}}</span>
                    <span class="dimensions-hotsite__em-sub">{{sub}}</span>
                    {{#countdown}}
                        <span class="dimensions-hotsite__em-chip">{{countdown}}</span>
                    {{/countdown}}
                </div>
            {{/herodate}}
            {{#heroticket}}
                <div class="dimensions-hotsite__ticket">
                    <div class="dimensions-hotsite__ticket-date">
                        <span class="dimensions-hotsite__em-main">{{datebig}}</span>
                        <span class="dimensions-hotsite__em-sub">{{sub}}</span>
                        {{#countdown}}
                            <span class="dimensions-hotsite__em-chip">{{.}}</span>
                        {{/countdown}}
                    </div>
                    <div class="dimensions-hotsite__ticket-cut" aria-hidden="true"></div>
                    <ul class="dimensions-hotsite__ticket-ways list-unstyled m-0">
                        <li class="dimensions-hotsite__way">
                            {{#pix}} i/location, core {{/pix}}
                            <span class="dimensions-hotsite__way-text">
                                <span class="dimensions-hotsite__way-main">{{site}}</span>
                                {{#venue}}
                                    <span class="dimensions-hotsite__way-sub">{{.}}</span>
                                {{/venue}}
                            </span>
                        </li>
                        <li class="dimensions-hotsite__way">
                            {{#pix}} t/play, core {{/pix}}
                            <span class="dimensions-hotsite__way-text">
                                <span class="dimensions-hotsite__way-main">{{live}}</span>
                                <span class="dimensions-hotsite__way-sub">{{livesub}}</span>
                            </span>
                        </li>
                    </ul>
                </div>
            {{/heroticket}}
            {{#herocomp}}
                <div class="dimensions-hotsite__comp">
                    <div class="dimensions-hotsite__comp-head">
                        <span class="dimensions-hotsite__comp-total">{{total}}</span>
                        {{#meetings}}
                            <span class="dimensions-hotsite__comp-meetings">{{.}}</span>
                        {{/meetings}}
                    </div>
                    <div class="dimensions-hotsite__comp-bar" role="img" aria-label="{{arialabel}}">
                        <span class="dimensions-hotsite__comp-online" style="width: {{onlinepct}}%"></span>
                        <span class="dimensions-hotsite__comp-inperson" style="width: {{inpersonpct}}%"></span>
                    </div>
                    <div class="dimensions-hotsite__comp-legend" aria-hidden="true">
                        <span class="dimensions-hotsite__comp-key"><span class="dimensions-hotsite__comp-swatch dimensions-hotsite__comp-swatch--online"></span>{{onlinelabel}}</span>
                        <span class="dimensions-hotsite__comp-key"><span class="dimensions-hotsite__comp-swatch dimensions-hotsite__comp-swatch--inperson"></span>{{inpersonlabel}}</span>
                    </div>
                </div>
            {{/herocomp}}
            {{#heroplace}}
                <div class="dimensions-hotsite__em {{#big}}dimensions-hotsite__em--big{{/big}}">
                    <span class="dimensions-hotsite__em-main">{{city}}</span>
                    {{#venue}}
                        <span class="dimensions-hotsite__em-sub">{{venue}}</span>
                    {{/venue}}
                    {{#dateline}}
                        <span class="dimensions-hotsite__em-sub">{{dateline}}</span>
                    {{/dateline}}
                    {{#meetings}}
                        <span class="dimensions-hotsite__em-sub">{{.}}</span>
                    {{/meetings}}
                </div>
            {{/heroplace}}
            </div>
            {{#hasbadges}}
                <ul class="dimensions-hotsite__badges" role="list" aria-label="{{#str}} hotsite_badges, theme_dimensions {{/str}}">
                    {{#badges}}
                        <li class="dimensions-hotsite__badge" role="listitem"><img src="{{url}}" alt="{{alt}}" loading="lazy"></li>
                    {{/badges}}
                </ul>
            {{/hasbadges}}
        </div>
    </header>
    <div class="dimensions-hotsite__columns">
        <div class="dimensions-hotsite__content">
            {{#video}}
                <div class="dimensions-hotsite__media" data-region="dimensions-hotsite-video">
                    <div class="dimensions-hotsite__player">{{{html}}}</div>
                    <div class="dimensions-hotsite__mediacaption">
                        <span class="dimensions-hotsite__mediatitle">{{caption}}</span>
                        <span class="dimensions-hotsite__mediahost" aria-hidden="true">{{host}}</span>
                    </div>
                </div>
            {{/video}}
            {{#summaryhtml}}
                <section class="dimensions-hotsite__section">
                    {{{summaryhtml}}}
                </section>
            {{/summaryhtml}}
            {{#sections}}
                <section class="dimensions-hotsite__section">
                    <h2 class="dimensions-hotsite__sectiontitle">{{title}}</h2>
                    {{{html}}}
                </section>
            {{/sections}}
        </div>
        <aside class="dimensions-hotsite__aside">
            <div class="dimensions-hotsite__card" id="dimensions-hotsite-card">
                {{#hasfacts}}
                    <dl class="dimensions-hotsite__facts">
                        {{#facts}}
                            <div class="dimensions-hotsite__fact">
                                <dt>{{label}}</dt>
                                <dd>{{value}}{{#note}}<small class="dimensions-hotsite__factnote">{{.}}</small>{{/note}}</dd>
                            </div>
                        {{/facts}}
                    </dl>
                {{/hasfacts}}
                <div class="dimensions-hotsite__enrol">
                    {{#isheldonly}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_enrolheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-hotsite__held">{{#str}} hotsite_heldon, theme_dimensions, {{heldon}} {{/str}}</p>
                        <p class="dimensions-hotsite__note">{{#str}} hotsite_heldnote, theme_dimensions {{/str}}</p>
                    {{/isheldonly}}
                    {{#isenrolled}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_alreadyenrolled, theme_dimensions {{/str}}</h2>
                        <a class="btn btn-primary dimensions-hotsite__btn" href="{{courseurl}}">
                            {{#str}} hotsite_accesscourse, theme_dimensions {{/str}}
                        </a>
                    {{/isenrolled}}
                    {{#ispending}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_pendingheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_pendingnote, theme_dimensions, {{appliedon}} {{/str}}</p>
                    {{/ispending}}
                    {{#iswaitlisted}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_waitlistedheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_pendingnote, theme_dimensions, {{appliedon}} {{/str}}</p>
                    {{/iswaitlisted}}
                    {{#isscheduled}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_scheduledheading, theme_dimensions, {{scheduledfrom}} {{/str}}</h2>
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_schedulednote, theme_dimensions {{/str}}</p>
                        {{#scheduleduntil}}
                            <p class="dimensions-hotsite__note">{{#str}} hotsite_scheduledend, theme_dimensions, {{scheduleduntil}} {{/str}}</p>
                        {{/scheduleduntil}}
                    {{/isscheduled}}
                    {{#isvisitor}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#isguestaccess}}{{#str}} hotsite_accessheading, theme_dimensions {{/str}}{{/isguestaccess}}{{^isguestaccess}}{{#str}} hotsite_enrolheading, theme_dimensions {{/str}}{{/isguestaccess}}</h2>
                        {{#hasoffers}}
                            <ul class="dimensions-hotsite__offers list-unstyled">
                                {{#offers}}
                                    <li>
                                        {{#name}}<span class="dimensions-hotsite__offername">{{.}}</span>{{/name}}
                                        {{> theme_dimensions/hotsite_offer }}
                                    </li>
                                {{/offers}}
                            </ul>
                        {{/hasoffers}}
                        {{#showlogin}}
                            <a class="btn btn-primary dimensions-hotsite__btn" href="{{loginurl}}">
                                {{#str}} hotsite_loginbutton, theme_dimensions {{/str}}
                            </a>
                            <p class="dimensions-hotsite__note">{{#str}} hotsite_loginnote, theme_dimensions {{/str}}</p>
                        {{/showlogin}}
                    {{/isvisitor}}
                    {{#isopen}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#tracksheading}}{{.}}{{/tracksheading}}{{^tracksheading}}{{#str}} hotsite_enrolheading, theme_dimensions {{/str}}{{/tracksheading}}</h2>
                    {{/isopen}}
                    {{#isclosed}}
                        <h2 class="dimensions-hotsite__cardtitle">{{#str}} hotsite_enrolheading, theme_dimensions {{/str}}</h2>
                    {{/isclosed}}
                    {{#issuspended}}
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_suspendednote, theme_dimensions {{/str}}</p>
                    {{/issuspended}}
                    {{#isexpired}}
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_expirednote, theme_dimensions, {{expiredon}} {{/str}}</p>
                    {{/isexpired}}
                    {{#isconditional}}
                        <p class="dimensions-hotsite__pending">{{#str}} hotsite_conditionalnote, theme_dimensions, {{prerequisite.name}} {{/str}}</p>
                        <a class="btn btn-outline-primary dimensions-hotsite__btn" href="{{prerequisite.url}}">
                            {{#str}} hotsite_prerequisitebutton, theme_dimensions {{/str}}
                        </a>
                    {{/isconditional}}
                    {{#showclosed}}
                        <p class="dimensions-hotsite__closed">{{#str}} hotsite_closed, theme_dimensions {{/str}}</p>
                    {{/showclosed}}
                    {{#isenrolled}}{{#isheld}}
                        <p class="dimensions-hotsite__note">{{#str}} hotsite_heldon, theme_dimensions, {{heldon}} {{/str}}</p>
                    {{/isheld}}{{/isenrolled}}
                    {{#methods}}
                        <div class="dimensions-hotsite__methodentry{{#trackname}} dimensions-hotsite__track{{/trackname}}">
                            {{#trackname}}
                                <h3 class="dimensions-hotsite__trackname">{{.}}</h3>
                            {{/trackname}}
                            {{#offer}}
                                {{> theme_dimensions/hotsite_offer }}
                            {{/offer}}
                            {{#isself}}
                                {{#requirespassword}}
                                    <form method="get" action="{{pageurl}}" class="dimensions-hotsite__method">
                                        <button type="submit"
                                                class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-hotsite__btn"
                                                data-id="{{courseid}}"
                                                data-instance="{{instanceid}}"
                                                data-form="{{dataform}}"
                                                data-title="{{datatitle}}">
                                            {{#str}} hotsite_enrolbutton, theme_dimensions {{/str}}
                                        </button>
                                        <p class="dimensions-hotsite__note">{{#str}} hotsite_keynote, theme_dimensions {{/str}}</p>
                                    </form>
                                {{/requirespassword}}
                                {{^requirespassword}}
                                    <div class="dimensions-hotsite__method">
                                        <a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-hotsite__btn"
                                           href="{{enrolurl}}">
                                            {{#str}} hotsite_enrolbutton, theme_dimensions {{/str}}
                                        </a>
                                        <p class="dimensions-hotsite__note">{{#str}} hotsite_selfnote, theme_dimensions {{/str}}</p>
                                    </div>
                                {{/requirespassword}}
                            {{/isself}}
                            {{#isapply}}
                                <form method="get" action="{{applyurl}}" class="dimensions-hotsite__method">
                                    <input type="hidden" name="instance" value="{{instanceid}}">
                                    <button type="submit"
                                            class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-hotsite__btn"
                                            data-id="{{courseid}}"
                                            data-instance="{{instanceid}}"
                                            data-form="{{dataform}}"
                                            data-title="{{datatitle}}">
                                        {{#str}} hotsite_applybutton, theme_dimensions {{/str}}
                                    </button>
                                    <p class="dimensions-hotsite__note">{{#str}} hotsite_applynote, theme_dimensions {{/str}}</p>
                                </form>
                            {{/isapply}}
                            {{#isfee}}
                                <form method="post" action="{{pageurl}}" class="dimensions-hotsite__method">
                                    <div class="dimensions-hotsite__cost">{{costdisplay}}</div>
                                    <button type="submit"
                                            class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-hotsite__btn"
                                            data-action="core_payment/triggerPayment"
                                            data-component="enrol_fee"
                                            data-paymentarea="fee"
                                            data-itemid="{{instanceid}}"
                                            data-cost="{{datacost}}"
                                            data-successurl="{{successurl}}"
                                            data-description="{{description}}">
                                        {{#str}} hotsite_enrolbutton, theme_dimensions {{/str}}
                                    </button>
                                </form>
                            {{/isfee}}
                            {{#isguest}}
                                <div class="dimensions-hotsite__method dimensions-hotsite__method--guest">
                                    <a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-secondary{{/primary}} dimensions-hotsite__btn"
                                       href="{{guesturl}}">
                                        {{#str}} hotsite_guestbutton, theme_dimensions {{/str}}
                                    </a>
                                    {{#guestnote}}
                                        <p class="dimensions-hotsite__note">{{#str}} hotsite_guestnote, theme_dimensions {{/str}}</p>
                                        <p class="dimensions-hotsite__note"><a href="{{loginurl}}">{{#str}} hotsite_enrolledlogin, theme_dimensions {{/str}}</a></p>
                                    {{/guestnote}}
                                </div>
                            {{/isguest}}
                            {{#isfallback}}
                                <div class="dimensions-hotsite__method dimensions-hotsite__widget">
                                    {{{widgethtml}}}
                                </div>
                            {{/isfallback}}
                        </div>
                    {{/methods}}
                </div>
            </div>
        </aside>
    </div>
    {{#bar}}
        <div class="dimensions-hotsite__bar">
            <a class="btn btn-primary dimensions-hotsite__btn" href="{{url}}">{{label}}</a>
            {{#note}}<p class="dimensions-hotsite__barnote">{{.}}</p>{{/note}}
        </div>
    {{/bar}}
</div>
