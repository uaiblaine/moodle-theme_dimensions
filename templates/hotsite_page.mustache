        "facts": [
            {"label": "Modalidade", "value": "Híbrido", "note": null},
            {"label": "Formato de estudo", "value": "Autoinstrucional", "note": "no seu ritmo"},
            {"label": "Carga horária", "value": "60 horas", "note": "36 online + 24 presencial"}
