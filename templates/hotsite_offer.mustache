{{!
    @template theme_dimensions/hotsite_offer

    What one enrolment method declares about its seats and its deadline, above its button on the
    hotsite (round 6, decisions D4-D6): the configured total, never what is left, and the deadline
    with the closing note of its last days. Every value is plain text from
    \theme_dimensions\local\hotsite\offer::export(); the icons are decoration.

    Example context (json):
    {
        "hasseats": true,
        "seats": "40 seats",
        "hasuntil": true,
        "until": "Enrolment until 26/10/26",
        "untilshort": "Enrolment until 26/10",
        "urgent": "Closes in 2 days"
    }
}}
<ul class="dimensions-hotsite__offer list-unstyled">
    {{#hasseats}}
        <li class="dimensions-hotsite__offerline">{{#pix}} i/users, core {{/pix}}<span>{{seats}}</span></li>
    {{/hasseats}}
    {{#hasuntil}}
        <li class="dimensions-hotsite__offerline">{{#pix}} i/calendar, core {{/pix}}<span>{{until}}</span>{{#urgent}} <span class="dimensions-hotsite__urgent">{{.}}</span>{{/urgent}}</li>
    {{/hasuntil}}
</ul>
