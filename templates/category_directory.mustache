<section class="dim-vitrine dim-vitrine--directory dim-vitrine--cards" data-region="dim-vitrine" data-categoryid="{{categoryid}}" data-vitrine="{{vitrine}}">
    {{#search}}
    {{> theme_dimensions/category_searchline }}
    {{/search}}
    {{#areas}}
    {{> theme_dimensions/category_areas }}
    {{/areas}}
</section>
