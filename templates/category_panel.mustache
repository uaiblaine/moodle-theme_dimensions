<section class="dim-panel__sec" role="region" aria-labelledby="dim-panel-title" data-region="dim-panel-section" data-categoryid="{{id}}">
    <div class="dim-panel__clip">
        <div class="dim-panel__inner">
            <div class="dim-panel__box">
                <div class="dim-panel__head">
                    <div class="dim-panel__titles">
                        <span class="dim-panel__eyebrow">{{#str}}category_panel_eyebrow, theme_dimensions{{/str}}</span>
                        <h3 class="dim-panel__title" id="dim-panel-title" tabindex="-1" aria-describedby="dim-panel-sub" data-region="dim-panel-title" data-focuskey="title">{{#str}}category_panel_title, theme_dimensions{{/str}} {{#haslink}}<a href="{{titleurl}}">{{name}}</a>{{/haslink}}{{^haslink}}{{name}}{{/haslink}}</h3>
                        <p class="dim-panel__sub" id="dim-panel-sub" data-region="dim-panel-subtitle">{{#isloading}}{{#str}}category_panel_loading, theme_dimensions, {{name}}{{/str}}{{/isloading}}{{#isskeleton}}{{#str}}category_panel_loading, theme_dimensions, {{name}}{{/str}}{{/isskeleton}}{{#iserror}}{{#str}}category_panel_error, theme_dimensions, {{name}}{{/str}}{{/iserror}}{{^isloading}}{{^isskeleton}}{{^iserror}}{{subtitle}}{{/iserror}}{{/isskeleton}}{{/isloading}}</p>
                    </div>
                    <div class="dim-panel__tools">
                        {{#jsmode}}
                        <div class="dim-panel__sort" role="radiogroup" aria-label="{{#str}}category_panel_sort, theme_dimensions, {{name}}{{/str}}" data-region="dim-panel-sort">
                            <button type="button" class="dim-panel__sortopt" role="radio" data-action="dim-panel-sort" data-psort="recent" data-focuskey="psort-recent" aria-checked="{{#psortname}}false{{/psortname}}{{^psortname}}true{{/psortname}}" tabindex="{{#psortname}}-1{{/psortname}}{{^psortname}}0{{/psortname}}">{{#str}}category_sort_recent, theme_dimensions{{/str}}</button>
                            <button type="button" class="dim-panel__sortopt" role="radio" data-action="dim-panel-sort" data-psort="name" data-focuskey="psort-name" aria-checked="{{#psortname}}true{{/psortname}}{{^psortname}}false{{/psortname}}" tabindex="{{#psortname}}0{{/psortname}}{{^psortname}}-1{{/psortname}}">{{#str}}category_sort_name, theme_dimensions{{/str}}</button>
                        </div>
                        <button type="button" class="dim-panel__close" data-action="dim-panel-close" data-focuskey="close" aria-label="{{#str}}category_panel_closelabel, theme_dimensions, {{name}}{{/str}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                        {{/jsmode}}
                        {{^jsmode}}
                        <div class="dim-panel__sort" role="group" aria-label="{{#str}}category_panel_sort, theme_dimensions, {{name}}{{/str}}" data-region="dim-panel-sort">
                            <a class="dim-panel__sortopt" href="{{sorturlrecent}}" data-action="dim-panel-sort" data-psort="recent" data-focuskey="psort-recent"{{^psortname}} aria-current="true"{{/psortname}}>{{#str}}category_sort_recent, theme_dimensions{{/str}}</a>
                            <a class="dim-panel__sortopt" href="{{sorturlname}}" data-action="dim-panel-sort" data-psort="name" data-focuskey="psort-name"{{#psortname}} aria-current="true"{{/psortname}}>{{#str}}category_sort_name, theme_dimensions{{/str}}</a>
                        </div>
                        <a class="dim-panel__close" href="{{closeurl}}" data-action="dim-panel-close" data-focuskey="close" aria-label="{{#str}}category_panel_closelabel, theme_dimensions, {{name}}{{/str}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></a>
                        {{/jsmode}}
                    </div>
                </div>
                <nav class="dim-panel__also" data-region="dim-panel-also"{{#also.has}} aria-labelledby="dim-panel-also-label"{{/also.has}}{{^also.has}} hidden{{/also.has}}>
                    {{#also.has}}
                    <span class="dim-panel__alsolabel" id="dim-panel-also-label">{{#str}}category_panel_also, theme_dimensions, {{name}}{{/str}}</span>
                    {{#also.pills}}
                    {{#haslink}}<a class="dim-panel__alsopill" href="{{url}}" style="{{style}}"><i class="dim-panel__dot" aria-hidden="true"></i>{{name}}</a>{{/haslink}}
                    {{^haslink}}<span class="dim-panel__alsopill" style="{{style}}"><i class="dim-panel__dot" aria-hidden="true"></i>{{name}}</span>{{/haslink}}
                    {{/also.pills}}
                    {{#also.hasmore}}
                    <a class="dim-panel__alsopill dim-panel__alsopill--more" href="{{also.moreurl}}" aria-label="{{#str}}category_panel_alsoall, theme_dimensions, {{name}}{{/str}}">+{{also.morecount}}</a>
                    {{/also.hasmore}}
                    {{/also.has}}
                </nav>
                <div class="dim-panel__body{{#isloading}} dim-panel__body--loading{{/isloading}}" data-region="dim-panel-body"{{#isloading}} aria-busy="true"{{/isloading}}>
                    {{#isrows}}
                    <div class="dim-panel__railwrap">
                        {{^few}}
                        <button type="button" class="dim-panel__arrow dim-panel__arrow--prev dim-panel__arrow--off" data-action="dim-panel-prev" aria-hidden="true" tabindex="-1" title="{{#str}}category_panel_prev, theme_dimensions{{/str}}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                        <button type="button" class="dim-panel__arrow dim-panel__arrow--next" data-action="dim-panel-next" aria-hidden="true" tabindex="-1" title="{{#str}}category_panel_next, theme_dimensions{{/str}}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                        {{/few}}
                        <ul class="dim-panel__rail{{#few}} dim-panel__rail--few{{/few}}" role="list" data-region="dim-panel-rail">
                            {{#cards}}
                            <li class="dim-panel__item">
                                {{> theme_dimensions/category_card }}
                            </li>
                            {{/cards}}
                            {{#tile.has}}
                            <li class="dim-panel__item dim-panel__item--tile"><a class="dim-panel__tile" href="{{tile.url}}" tabindex="-1"><b>+{{tile.count}}</b><span>{{tile.label}}</span></a></li>
                            {{/tile.has}}
                        </ul>
                    </div>
                    {{/isrows}}
                    {{#isskeleton}}
                    <div class="dim-panel__railwrap">
                        <ul class="dim-panel__rail" role="list" data-region="dim-panel-rail" aria-busy="true">
                            <li class="dim-panel__item" aria-hidden="true"><div class="dim-panel__skel"><span class="dim-panel__skelmedia"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span><span class="dim-panel__skelbar dim-panel__skelbar--title"></span><span class="dim-panel__skelbar"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span></div></li>
                            <li class="dim-panel__item" aria-hidden="true"><div class="dim-panel__skel"><span class="dim-panel__skelmedia"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span><span class="dim-panel__skelbar dim-panel__skelbar--title"></span><span class="dim-panel__skelbar"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span></div></li>
                            <li class="dim-panel__item" aria-hidden="true"><div class="dim-panel__skel"><span class="dim-panel__skelmedia"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span><span class="dim-panel__skelbar dim-panel__skelbar--title"></span><span class="dim-panel__skelbar"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span></div></li>
                            <li class="dim-panel__item" aria-hidden="true"><div class="dim-panel__skel"><span class="dim-panel__skelmedia"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span><span class="dim-panel__skelbar dim-panel__skelbar--title"></span><span class="dim-panel__skelbar"></span><span class="dim-panel__skelbar dim-panel__skelbar--short"></span></div></li>
                        </ul>
                    </div>
                    {{/isskeleton}}
                    {{#iserror}}
                    <div class="dim-panel__state dim-panel__state--error"><p><b>{{#str}}category_panel_error, theme_dimensions, {{name}}{{/str}}</b> {{#str}}category_panel_errorhint, theme_dimensions{{/str}}</p><button type="button" class="dim-panel__retry" data-action="dim-panel-retry" data-focuskey="retry">{{#str}}category_panel_retry, theme_dimensions{{/str}}</button></div>
                    {{/iserror}}
                    {{#isempty}}
                    <div class="dim-panel__state"><p><b>{{#str}}category_panel_empty, theme_dimensions, {{name}}{{/str}}</b> {{#str}}category_panel_emptyhint, theme_dimensions{{/str}}</p></div>
                    {{/isempty}}
                    {{#iszero}}
                    <div class="dim-panel__state">
                        <p><b>{{zero}}</b></p>
                        {{#hassuggestions}}
                        <div class="dim-panel__sugg" data-region="dim-panel-suggestions"><span>{{#str}}category_panel_resultsin, theme_dimensions{{/str}}</span>
                            {{#suggestions}}
                            {{#jsmode}}<button type="button" class="dim-panel__suggestion" data-action="dim-panel-openarea" data-categoryid="{{id}}" data-focuskey="suggest-{{id}}">{{name}} <span class="dim-panel__suggestioncount" aria-hidden="true">{{count}}</span><span class="visually-hidden">{{countlabel}}</span></button>{{/jsmode}}
                            {{^jsmode}}<a class="dim-panel__suggestion" href="{{url}}" data-action="dim-panel-openarea" data-categoryid="{{id}}" data-focuskey="suggest-{{id}}">{{name}} <span class="dim-panel__suggestioncount" aria-hidden="true">{{count}}</span><span class="visually-hidden">{{countlabel}}</span></a>{{/jsmode}}
                            {{/suggestions}}
                        </div>
                        {{/hassuggestions}}
                    </div>
                    {{/iszero}}
                </div>
                <div class="dim-panel__foot" data-region="dim-panel-foot">
                    {{^isloading}}
                    {{#counter}}
                    <span class="dim-panel__counter" data-region="dim-panel-counter" aria-hidden="true">{{counter}}</span>
                    {{/counter}}
                    <div class="dim-panel__footend">
                        {{#cta.has}}
                        <a class="dim-panel__cta" href="{{cta.url}}" data-region="dim-panel-cta" data-focuskey="cta">{{cta.label}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        {{/cta.has}}
                        {{#seeaslist.has}}
                        <a class="dim-panel__cta dim-panel__cta--ghost" href="{{seeaslist.url}}" data-region="dim-panel-cta" data-focuskey="cta">{{#str}}category_seeaslist, theme_dimensions{{/str}}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                        {{/seeaslist.has}}
                    </div>
                    {{/isloading}}
                </div>
            </div>
        </div>
    </div>
</section>
