<section class="dim-vitrine {{viewclass}}" data-region="dim-vitrine" data-categoryid="{{categoryid}}" data-vitrine="{{vitrine}}">
    {{#pages}}
    {{> theme_dimensions/category_pages }}
    {{/pages}}
    {{#toolbar}}
    {{> theme_dimensions/category_toolbar }}
    {{/toolbar}}
    <div class="dim-vitrine__shell">
        {{#hastree}}
        <nav class="dim-vitrine__tree" data-region="dim-vitrine-tree" aria-label="{{treelabel}}">
            <details class="dim-vitrine__treebox" data-region="dim-vitrine-treebox" open>
                <summary class="dim-vitrine__treetoggle">{{treeboxlabel}}</summary>
                <ul class="dim-tree" role="list">
                    {{#tree}}
                    <li class="dim-tree__item" data-depth="{{depth}}">
                        {{#linkable}}<a class="dim-tree__link{{#current}} dim-tree__link--on{{/current}}" href="{{url}}" data-region="dim-tree-link" data-categoryid="{{id}}"{{#current}} aria-current="true"{{/current}}>{{name}}</a>{{/linkable}}
                        {{^linkable}}<span class="dim-tree__text">{{name}}</span>{{/linkable}}
                    </li>
                    {{/tree}}
                </ul>
            </details>
        </nav>
        {{/hastree}}
        <div class="dim-vitrine__content">
            {{#areas}}
            {{> theme_dimensions/category_areas }}
            {{/areas}}
            {{#isgrouped}}
            <section class="dim-direct" data-region="dim-direct" aria-labelledby="dim-direct-title"{{^direct.show}} hidden{{/direct.show}}>
                <div class="dim-direct__head">
                    <h2 class="dim-direct__title" id="dim-direct-title" tabindex="-1">{{direct.heading}}</h2>
                </div>
            {{/isgrouped}}
            <ul class="dim-vitrine__grid" role="list" data-region="dim-vitrine-grid"{{^hascards}} hidden{{/hascards}}>
                {{#cards}}
                <li class="dim-vitrine__item">
                    {{> theme_dimensions/category_card }}
                </li>
                {{/cards}}
            </ul>
            <div class="dim-vitrine__empty" data-region="dim-vitrine-empty"{{#hascards}} hidden{{/hascards}}>
                <p>{{emptylabel}}</p>
                {{#hasfilters}}
                <a class="btn btn-outline-primary btn-sm" href="{{clearurl}}" data-action="dim-clear">{{clearlabel}}</a>
                {{/hasfilters}}
            </div>
            <div class="dim-vitrine__pager" data-region="dim-vitrine-pager">
                <div class="dim-vitrine__pagerbar" data-region="dim-vitrine-pagerbar">{{{pager}}}</div>
                <button type="button" class="btn btn-outline-primary btn-sm dim-vitrine__loadmore dim-live-only" data-action="dim-loadmore" data-label="{{loadmorelabel}}" data-loading="{{loadinglabel}}"{{^hasmore}} hidden{{/hasmore}}>{{loadmorelabel}}</button>
                <a class="btn btn-outline-primary btn-sm dim-vitrine__nextpage dim-live-only" data-region="dim-vitrine-nextpage" href="{{nexturl}}" hidden>{{continuelabel}}</a>
            </div>
            {{#isgrouped}}
            </section>
            {{/isgrouped}}
        </div>
    </div>
</section>
