<section class="dim-areas{{#isopen}} dim-areas--open{{/isopen}}" data-region="dim-areas" data-categoryid="{{categoryid}}" data-filtered="{{#filtered}}1{{/filtered}}{{^filtered}}0{{/filtered}}" data-elsewhere="{{elsewhere}}" aria-labelledby="dim-areas-title">
    <div class="dim-areas__head">
        <h2 class="dim-areas__title" id="dim-areas-title">{{heading}}</h2>
        {{^isroot}}
        <a class="dim-areas__skip" href="#dim-direct-title" data-region="dim-direct-skip"{{^hasdirectlink}} hidden{{/hasdirectlink}}>{{directlinklabel}}</a>
        {{/isroot}}
    </div>
    {{#hasposters}}
    <ul class="dim-vitrine__grid dim-areas__grid" role="list" data-region="dim-areas-grid">
        {{#posters}}
        <li class="dim-areas__item"{{#hidden}} hidden{{/hidden}}>{{> theme_dimensions/category_directory_card }}</li>
        {{#isopen}}
        <li class="dim-panel" id="dim-panel" data-region="dim-panel" style="{{panelstyle}}">{{#panel}}{{> theme_dimensions/category_panel }}{{/panel}}</li>
        {{/isopen}}
        {{/posters}}
        {{^isopen}}
        <li class="dim-panel" id="dim-panel" data-region="dim-panel" hidden></li>
        {{/isopen}}
    </ul>
    {{#hashint}}
    <p class="dim-areas__hint" data-region="dim-areas-hint"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#str}}category_areas_hint, theme_dimensions{{/str}}</p>
    {{/hashint}}
    <div class="dim-areas__allempty" data-region="dim-areas-empty"{{^allempty}} hidden{{/allempty}}>
        <p><b>{{allemptylabel}}</b></p>
        <p>{{allemptyhint}}</p>
        <p class="dim-areas__allemptyways">
            <a class="dim-areas__allemptyclear" href="{{clearurl}}" data-action="dim-clear">{{clearlabel}}</a>
            <a class="dim-areas__searchall" href="{{searchallurl}}" data-region="dim-areas-searchall"{{^searchallurl}} hidden{{/searchallurl}}>{{#str}}category_searchall, theme_dimensions{{/str}}</a>
        </p>
    </div>
    {{#hasmore}}
    <details class="dim-vitrine__more dim-areas__more" data-region="dim-areas-more"{{#moreopen}} open{{/moreopen}}{{#morehidden}} hidden{{/morehidden}}>
        <summary class="dim-vitrine__morebutton" data-region="dim-areas-moresummary">{{morelabel}}</summary>
        <ul class="dim-vitrine__grid dim-areas__grid" role="list" data-region="dim-areas-grid">
            {{#postersmore}}
            <li class="dim-areas__item"{{#hidden}} hidden{{/hidden}}>{{> theme_dimensions/category_directory_card }}</li>
            {{#isopen}}
            <li class="dim-panel" id="dim-panel" data-region="dim-panel" style="{{panelstyle}}">{{#panel}}{{> theme_dimensions/category_panel }}{{/panel}}</li>
            {{/isopen}}
            {{/postersmore}}
        </ul>
    </details>
    {{/hasmore}}
    <details class="dim-areas__nomatch" id="dim-nomatch" data-region="dim-areas-nomatch" data-label-all="{{nomatch.labelall}}" data-label-less="{{nomatch.labelless}}"{{^nomatch.show}} hidden{{/nomatch.show}}>
        <summary class="dim-areas__nomatchsummary" data-region="dim-nomatch-summary">{{nomatch.label}}</summary>
        <ul class="dim-areas__nomatchlist" role="list" data-region="dim-nomatch-list">
            {{#nomatch.areas}}
            <li data-categoryid="{{id}}"{{#isopen}} hidden{{/isopen}}>{{#haslink}}<a href="{{url}}">{{name}}</a>{{/haslink}}{{^haslink}}{{name}}{{/haslink}}</li>
            {{/nomatch.areas}}
        </ul>
    </details>
    {{/hasposters}}
    {{^hasposters}}
    <div class="dim-vitrine__empty" data-region="dim-vitrine-empty">
        <p>{{emptylabel}}</p>
    </div>
    {{/hasposters}}
    <p class="visually-hidden" role="status" aria-live="polite" data-region="dim-panel-status"></p>
</section>
