{{!
    @template theme_dimensions/competency_classreport_learner

    A learner's name in the class report, linked to their breakdown on core's page
    (report/competency/index.php?id=&user=), where each competency of the course is listed with its evidence.

    Context variables required for this template:
    * url - The learner's breakdown.
    * name - The learner's full name, plain.

    Example context (json):
    {
        "url": "https://example.com/report/competency/index.php?id=2&user=3",
        "name": "Sam Student"
    }
}}
<a class="dim-comp-classreport__learner" href="{{url}}">{{name}}</a>
