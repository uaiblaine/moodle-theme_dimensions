{{!
    @template theme_dimensions/calendar_block_upcoming

    block_calendar_upcoming's content drawn with the theme's calendar
    (docs/calendar/PROPOSAL.md section 17): the first items of core's upcoming
    window, each a link where the theme's calendar page leads it, its time and
    its course as text, its key as a dot and, for a screen reader, as words;
    then "Full calendar", the theme's page. Every text arrives in the plain
    spelling and is escaped here, once.

    Example context (json):
    {
        "items": [
            {
                "name": "Assignment due",
                "url": "https://example.com/mod/assign/view.php?id=4",
                "when": "Tuesday, 3 November, 23:59",
                "key": "activity",
                "keylabel": "Activities",
                "course": "Course A & B"
            }
        ],
        "empty": false,
        "pageurl": "https://example.com/r.php/theme_dimensions/calendar"
    }
}}
<div class="dim-calblock dim-calblock--upcoming" data-region="dim-calblock-upcoming">
    {{#empty}}
    <p class="dim-calblock__empty">{{#str}}calendarblock_upcomingempty, theme_dimensions{{/str}}</p>
    {{/empty}}
    {{^empty}}
    <ul class="dim-calblock__agenda">
        {{#items}}
        <li class="dim-calblock__item" data-region="dim-calblock-item">
            <span class="dim-calblock__mark dim-cal-key--{{key}}" aria-hidden="true"></span>
            <span class="dim-calblock__text">
                <a class="dim-calblock__name" href="{{url}}">{{name}}</a>
                <span class="dim-calblock__when">{{when}}</span>
                {{#course}}<span class="dim-calblock__course">{{course}}</span>{{/course}}
                <span class="visually-hidden">{{keylabel}}</span>
            </span>
        </li>
        {{/items}}
    </ul>
    {{/empty}}
    <a class="dim-calblock__full" href="{{pageurl}}">{{#str}}calendarblock_full, theme_dimensions{{/str}}</a>
</div>
