{{!
    @template theme_dimensions/core_user/myprofile_tree

    The user profile, as a set of cards.

    Keeps the profile_tree class core's renderer emits, because Boost styles it and other
    plugins may target it; the dimensions-profile class beside it is what replaces core's
    two-CSS-column layout with a flex row that cannot resolve to three columns.

    Context variables required for this template:
    * categories - Array of category contexts, each as described in the category template.

    Example context (json):
    {
        "categories": [
            {
                "title": "User details",
                "classes": "node_category",
                "hasfacts": true,
                "facts": [
                    {
                        "name": "email",
                        "title": "Email address",
                        "hasurl": false,
                        "url": "",
                        "content": "aluno@example.org",
                        "hasicon": false,
                        "iconhtml": "",
                        "classes": ""
                    }
                ],
                "hasactions": true,
                "actions": [
                    {
                        "name": "editprofile",
                        "title": "Edit profile",
                        "hasurl": true,
                        "url": "https://example.org/user/edit.php",
                        "hasicon": false,
                        "iconhtml": "",
                        "classes": "editprofile"
                    }
                ]
            }
        ]
    }
}}
<div class="profile_tree dimensions-profile">
    {{#categories}}
        {{> theme_dimensions/core_user/myprofile_category }}
    {{/categories}}
</div>
