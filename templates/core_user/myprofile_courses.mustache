{{!
    @template theme_dimensions/core_user/myprofile_courses

    The course list of a profile's "Course profiles" node, in the markup core builds for it in
    core_myprofile_navigation(): printed in place of core's list when that one names a course the
    viewer may not discover.

    Context variables required for this template:
    * courses - The courses left: name (formatted and escaped by the caller), url (false for the page's own course), dimmed.
    * viewmore - The address of the whole list, or false when the list was not cut.

    Example context (json):
    {
        "courses": [
            {"name": "Human rights", "url": "https://example.org/user/view.php?id=5&course=8", "dimmed": false},
            {"name": "First aid", "url": false, "dimmed": false}
        ],
        "viewmore": "https://example.org/user/profile.php?id=5&showallcourses=1"
    }
}}
<ul>{{#courses}}<li>{{#url}}<a {{#dimmed}}class="dimmed" {{/dimmed}}href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}{{{name}}}{{/url}}</li>{{/courses}}{{#viewmore}}<li class="viewmore"><a title="{{#str}}viewmore{{/str}}" href="{{viewmore}}">{{#str}}viewmore{{/str}}</a></li>{{/viewmore}}</ul>
