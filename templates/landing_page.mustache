<div class="dimensions-landing{{#bar}} dimensions-landing--hasbar{{/bar}}" data-region="dimensions-landing" data-courseid="{{courseid}}">
    {{^herofullwidth}}
    <header class="dimensions-landing__hero">
        {{> theme_dimensions/landing_hero }}
    </header>
    {{/herofullwidth}}
    <div class="dimensions-landing__columns">
        <div class="dimensions-landing__content">
            {{#video}}
                <div class="dimensions-landing__media" data-region="dimensions-landing-video">
                    <div class="dimensions-landing__player">{{{html}}}</div>
                    <div class="dimensions-landing__mediacaption">
                        <span class="dimensions-landing__mediatitle">{{caption}}</span>
                        <span class="dimensions-landing__mediahost" aria-hidden="true">{{host}}</span>
                    </div>
                </div>
            {{/video}}
            {{#summaryhtml}}
                <section class="dimensions-landing__section dimensions-landing__section--summary" data-region="dimensions-landing-summary">
                    <div class="dimensions-landing__summarytext" id="dimensions-landing-summarytext" data-region="dimensions-landing-summarytext">
                        {{{summaryhtml}}}
                    </div>
                    <button type="button" class="dimensions-landing__summarytoggle" data-region="dimensions-landing-summarytoggle"
                            aria-expanded="false" aria-controls="dimensions-landing-summarytext"
                            data-label-more="{{#str}} landing_summary_more, theme_dimensions {{/str}}"
                            data-label-less="{{#str}} landing_summary_less, theme_dimensions {{/str}}" hidden>
                        <span data-region="dimensions-landing-summarylabel">{{#str}} landing_summary_more, theme_dimensions {{/str}}</span>
                        <i class="fa fa-chevron-down" aria-hidden="true"></i>
                    </button>
                </section>
                {{#js}}
                    require(['theme_dimensions/landingsummary'], function(summary) {
                        summary.init();
                    });
                {{/js}}
            {{/summaryhtml}}
            {{#trail}}
                <section class="dimensions-landing__trail" data-region="dimensions-landing-trail" aria-labelledby="dimensions-landing-trail-title">
                    <h2 class="dimensions-landing__sectiontitle" id="dimensions-landing-trail-title">{{#str}} landing_trail_steps, theme_dimensions {{/str}}</h2>
                    <ol class="dimensions-landing__steps">
                        {{#steps}}
                            <li class="dimensions-landing__step{{#isghost}} dimensions-landing__step--ghost{{/isghost}}{{#state}} dimensions-landing__step--{{.}}{{/state}}"{{#state}} data-state="{{.}}"{{/state}}>
                                <span class="dimensions-landing__stepnum" aria-hidden="true">{{#isdone}}{{#pix}} i/checked, core {{/pix}}{{/isdone}}{{#islocked}}{{#pix}} t/locked, core {{/pix}}{{/islocked}}{{^isdone}}{{^islocked}}{{n}}{{/islocked}}{{/isdone}}</span>
                                {{^isghost}}
                                    <article class="dimensions-landing__stepcard">
                                        <div class="dimensions-landing__stepcover" aria-hidden="true">
                                            {{#imageurl}}<img src="{{.}}" alt="" loading="lazy">{{/imageurl}}
                                        </div>
                                        <div class="dimensions-landing__stepbody">
                                            {{#category}}
                                                <span class="dimensions-landing__stepcat">{{.}}</span>
                                            {{/category}}
                                            <h3 class="dimensions-landing__stepname"><span class="visually-hidden">{{#str}} landing_trail_stepnumber, theme_dimensions, {{n}} {{/str}}: </span><a href="{{url}}">{{name}}</a></h3>
                                            <div class="dimensions-landing__stepmeta">
                                                {{#hours}}
                                                    <span class="dimensions-landing__stephours">{{.}}</span>
                                                {{/hours}}
                                                {{#statelabel}}
                                                    <span class="dimensions-landing__stepstate">{{.}}</span>
                                                {{/statelabel}}
                                                {{#when}}
                                                    <span class="dimensions-landing__stepwhen">{{#pix}} i/calendar, core {{/pix}}{{.}}</span>
                                                {{/when}}
                                            </div>
                                        </div>
                                    </article>
                                {{/isghost}}
                                {{#isghost}}
                                    <div class="dimensions-landing__stepcard dimensions-landing__stepcard--ghost">
                                        <div class="dimensions-landing__stepcover" aria-hidden="true">{{#pix}} t/locked, core {{/pix}}</div>
                                        <div class="dimensions-landing__stepbody">
                                            <span class="dimensions-landing__stepbone" aria-hidden="true"></span>
                                            <p class="dimensions-landing__stepghost"><span class="visually-hidden">{{#str}} landing_trail_stepnumber, theme_dimensions, {{n}} {{/str}}: </span>{{#str}} landing_trail_ghost, theme_dimensions {{/str}}</p>
                                            <a class="dimensions-landing__steplogin" href="{{loginurl}}">{{#str}} login {{/str}}</a>
                                        </div>
                                    </div>
                                {{/isghost}}
                            </li>
                        {{/steps}}
                    </ol>
                </section>
            {{/trail}}
            {{#hassections}}
                <div class="dimensions-landing__panel" data-region="dimensions-landing-panel">
                    {{#sections}}
                        <section class="dimensions-landing__section">
                            <h2 class="dimensions-landing__sectiontitle">{{title}}</h2>
                            {{{html}}}
                        </section>
                    {{/sections}}
                </div>
            {{/hassections}}
        </div>
        <aside class="dimensions-landing__aside">
            <div class="dimensions-landing__card" id="dimensions-landing-card">
                {{#hasfacts}}
                    <dl class="dimensions-landing__facts">
                        {{#facts}}
                            <div class="dimensions-landing__fact">
                                <dt>{{label}}</dt>
                                <dd>{{value}}{{#note}}<small class="dimensions-landing__factnote">{{.}}</small>{{/note}}</dd>
                            </div>
                        {{/facts}}
                    </dl>
                {{/hasfacts}}
                <div class="dimensions-landing__enrol">
                    {{#isheldonly}}
                        <h2 class="dimensions-landing__cardtitle">{{#str}} landing_enrolheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-landing__held">{{#str}} landing_heldon, theme_dimensions, {{heldon}} {{/str}}</p>
                        <p class="dimensions-landing__note">{{#str}} landing_heldnote, theme_dimensions {{/str}}</p>
                    {{/isheldonly}}
                    {{#isenrolled}}
                        {{#trail}}
                            <h2 class="dimensions-landing__cardtitle">{{#str}} landing_trail_enrolled, theme_dimensions {{/str}}</h2>
                        {{/trail}}
                        {{^trail}}
                            <h2 class="dimensions-landing__cardtitle">{{#str}} landing_alreadyenrolled, theme_dimensions {{/str}}</h2>
                        {{/trail}}
                        {{#trailcontinue}}
                            <a class="btn btn-primary dimensions-landing__btn" href="{{url}}" data-region="dimensions-landing-continue">{{label}}</a>
                        {{/trailcontinue}}
                        {{^trailcontinue}}
                            <a class="btn btn-primary dimensions-landing__btn" href="{{courseurl}}">
                                {{#str}} landing_accesscourse, theme_dimensions {{/str}}
                            </a>
                        {{/trailcontinue}}
                    {{/isenrolled}}
                    {{#ispending}}
                        <h2 class="dimensions-landing__cardtitle">{{#str}} landing_pendingheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-landing__pending">{{#str}} landing_pendingnote, theme_dimensions, {{appliedon}} {{/str}}</p>
                    {{/ispending}}
                    {{#iswaitlisted}}
                        <h2 class="dimensions-landing__cardtitle">{{#str}} landing_waitlistedheading, theme_dimensions {{/str}}</h2>
                        <p class="dimensions-landing__pending">{{#str}} landing_pendingnote, theme_dimensions, {{appliedon}} {{/str}}</p>
                    {{/iswaitlisted}}
                    {{#isscheduled}}
                        <h2 class="dimensions-landing__cardtitle">{{#str}} landing_scheduledheading, theme_dimensions, {{scheduledfrom}} {{/str}}</h2>
                        <p class="dimensions-landing__pending">{{#str}} landing_schedulednote, theme_dimensions {{/str}}</p>
                        {{#scheduleduntil}}
                            <p class="dimensions-landing__note">{{#str}} landing_scheduledend, theme_dimensions, {{scheduleduntil}} {{/str}}</p>
                        {{/scheduleduntil}}
                    {{/isscheduled}}
                    {{#isvisitor}}
                        <h2 class="dimensions-landing__cardtitle">{{#isguestaccess}}{{#str}} landing_accessheading, theme_dimensions {{/str}}{{/isguestaccess}}{{^isguestaccess}}{{#str}} landing_enrolheading, theme_dimensions {{/str}}{{/isguestaccess}}</h2>
                        {{#hasoffers}}
                            <ul class="dimensions-landing__offers list-unstyled">
                                {{#offers}}
                                    <li>
                                        {{#name}}<span class="dimensions-landing__offername">{{.}}</span>{{/name}}
                                        {{> theme_dimensions/landing_offer }}
                                    </li>
                                {{/offers}}
                            </ul>
                        {{/hasoffers}}
                        {{#showlogin}}
                            <a class="btn btn-primary dimensions-landing__btn" href="{{loginurl}}">
                                {{#str}} landing_loginbutton, theme_dimensions {{/str}}
                            </a>
                            <p class="dimensions-landing__note">{{#str}} landing_loginnote, theme_dimensions {{/str}}</p>
                        {{/showlogin}}
                    {{/isvisitor}}
                    {{#isopen}}
                        <h2 class="dimensions-landing__cardtitle">{{#tracksheading}}{{.}}{{/tracksheading}}{{^tracksheading}}{{#str}} landing_enrolheading, theme_dimensions {{/str}}{{/tracksheading}}</h2>
                    {{/isopen}}
                    {{#isclosed}}
                        <h2 class="dimensions-landing__cardtitle">{{#str}} landing_enrolheading, theme_dimensions {{/str}}</h2>
                    {{/isclosed}}
                    {{#issuspended}}
                        <p class="dimensions-landing__pending">{{#str}} landing_suspendednote, theme_dimensions {{/str}}</p>
                    {{/issuspended}}
                    {{#isexpired}}
                        <p class="dimensions-landing__pending">{{#str}} landing_expirednote, theme_dimensions, {{expiredon}} {{/str}}</p>
                    {{/isexpired}}
                    {{#isconditional}}
                        <p class="dimensions-landing__pending">{{#str}} landing_conditionalnote, theme_dimensions, {{prerequisite.name}} {{/str}}</p>
                        <a class="btn btn-outline-primary dimensions-landing__btn" href="{{prerequisite.url}}">
                            {{#str}} landing_prerequisitebutton, theme_dimensions {{/str}}
                        </a>
                    {{/isconditional}}
                    {{#showclosed}}
                        <p class="dimensions-landing__closed">{{#str}} landing_closed, theme_dimensions {{/str}}</p>
                    {{/showclosed}}
                    {{#isenrolled}}{{#isheld}}
                        <p class="dimensions-landing__note">{{#str}} landing_heldon, theme_dimensions, {{heldon}} {{/str}}</p>
                    {{/isheld}}{{/isenrolled}}
                    {{#methods}}
                        <div class="dimensions-landing__methodentry{{#trackname}} dimensions-landing__track{{/trackname}}">
                            {{#trackname}}
                                <h3 class="dimensions-landing__trackname">{{.}}</h3>
                            {{/trackname}}
                            {{#offer}}
                                {{> theme_dimensions/landing_offer }}
                            {{/offer}}
                            {{#isself}}
                                {{#requirespassword}}
                                    <form method="get" action="{{pageurl}}" class="dimensions-landing__method">
                                        <button type="submit"
                                                class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-landing__btn"
                                                data-id="{{courseid}}"
                                                data-instance="{{instanceid}}"
                                                data-form="{{dataform}}"
                                                data-title="{{datatitle}}">
                                            {{#str}} landing_enrolbutton, theme_dimensions {{/str}}
                                        </button>
                                        <p class="dimensions-landing__note">{{#str}} landing_keynote, theme_dimensions {{/str}}</p>
                                    </form>
                                {{/requirespassword}}
                                {{^requirespassword}}
                                    <div class="dimensions-landing__method">
                                        <a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-landing__btn"
                                           href="{{enrolurl}}">
                                            {{#str}} landing_enrolbutton, theme_dimensions {{/str}}
                                        </a>
                                        <p class="dimensions-landing__note">{{#str}} landing_selfnote, theme_dimensions {{/str}}</p>
                                    </div>
                                {{/requirespassword}}
                            {{/isself}}
                            {{#isapply}}
                                <form method="get" action="{{applyurl}}" class="dimensions-landing__method">
                                    <input type="hidden" name="instance" value="{{instanceid}}">
                                    <button type="submit"
                                            class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-landing__btn"
                                            data-id="{{courseid}}"
                                            data-instance="{{instanceid}}"
                                            data-form="{{dataform}}"
                                            data-title="{{datatitle}}">
                                        {{#str}} landing_applybutton, theme_dimensions {{/str}}
                                    </button>
                                    <p class="dimensions-landing__note">{{#str}} landing_applynote, theme_dimensions {{/str}}</p>
                                </form>
                            {{/isapply}}
                            {{#isfee}}
                                <form method="post" action="{{pageurl}}" class="dimensions-landing__method">
                                    <div class="dimensions-landing__cost">{{costdisplay}}</div>
                                    <button type="submit"
                                            class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}} dimensions-landing__btn"
                                            data-action="core_payment/triggerPayment"
                                            data-component="enrol_fee"
                                            data-paymentarea="fee"
                                            data-itemid="{{instanceid}}"
                                            data-cost="{{datacost}}"
                                            data-successurl="{{successurl}}"
                                            data-description="{{description}}">
                                        {{#str}} landing_enrolbutton, theme_dimensions {{/str}}
                                    </button>
                                </form>
                            {{/isfee}}
                            {{#isguest}}
                                <div class="dimensions-landing__method dimensions-landing__method--guest">
                                    <a class="btn {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-secondary{{/primary}} dimensions-landing__btn"
                                       href="{{guesturl}}">
                                        {{#str}} landing_guestbutton, theme_dimensions {{/str}}
                                    </a>
                                    {{#guestnote}}
                                        <p class="dimensions-landing__note">{{#str}} landing_guestnote, theme_dimensions {{/str}}</p>
                                        <p class="dimensions-landing__note"><a href="{{loginurl}}">{{#str}} landing_enrolledlogin, theme_dimensions {{/str}}</a></p>
                                    {{/guestnote}}
                                </div>
                            {{/isguest}}
                            {{#isfallback}}
                                <div class="dimensions-landing__method dimensions-landing__widget">
                                    {{{widgethtml}}}
                                </div>
                            {{/isfallback}}
                        </div>
                    {{/methods}}
                    {{#manage}}
                        <div class="dimensions-landing__manage" data-region="dimensions-landing-manage">
                            <a class="btn btn-outline-primary dimensions-landing__btn" href="{{url}}">{{label}}</a>
                            <p class="dimensions-landing__note">{{note}}</p>
                        </div>
                    {{/manage}}
                    {{#trailcalendarurl}}
                        <a class="btn btn-outline-primary dimensions-landing__btn dimensions-landing__trailcalendar" href="{{trailcalendarurl}}" data-region="dimensions-landing-trailcalendar">
                            <i class="fa fa-calendar" aria-hidden="true"></i> {{#str}} landing_trail_calendar, theme_dimensions {{/str}}
                        </a>
                    {{/trailcalendarurl}}
                </div>
            </div>
        </aside>
    </div>
    {{#relatednotice}}
        <div class="dimensions-landing__relatednotice">
            {{> core/notification_warning }}
        </div>
    {{/relatednotice}}
    {{#related}}
        {{> theme_dimensions/related_band }}
    {{/related}}
    {{#bar}}
        <div class="dimensions-landing__bar">
            <a class="btn btn-primary dimensions-landing__btn" href="{{url}}">{{label}}</a>
            {{#note}}<p class="dimensions-landing__barnote">{{.}}</p>{{/note}}
        </div>
    {{/bar}}
</div>
