{{!
    @template block_lp/summary

    The learning plans block, overridden by Dimensions.

    Mirrors block_lp/summary of Moodle 5.3 (2026100500), blocks/lp/templates/summary.mustache. Re-diff
    it against that file on every core upgrade. See blocks/lp/classes/output/summary.php for the
    context.

    Kept from core: the three sections and their conditions, every link (each plan's url, each user
    competency's url, the plans page, the two review pages under pluginbaseurl), the headings as h3,
    the "View more" items as li.more (block_lp's stylesheet spaces them), the sub-content wrappers,
    the plan and competency names triple-stashed and the people and statuses double-stashed.
    Changed: each item is a row (dim-comp-block); the review status is a status pill instead of text
    after a dash, and the person is a quiet label in place of parentheses; the empty case keeps its
    two sentences in one paragraph.

    Context variables required for this template:
    * hasplans, hasactiveplans, hasmoreplans - booleans
    * activeplans - array of plan records (url, name)
    * plansurl, pluginbaseurl
    * hascompstoreview, hasmorecompstoreview - booleans
    * compstoreview - array of usercompetency (url, statusname), competency (shortname), user (fullname)
    * hasplanstoreview, hasmoreplanstoreview - booleans
    * planstoreview - array of plan (url, name, statusname), user (fullname)

    Example context (json):
    {
        "hasplans": true,
        "hasactiveplans": true,
        "activeplans": [
            {"url": "https://example.com/admin/tool/lp/plan.php?id=4", "name": "Leadership track"}
        ],
        "hasmoreplans": true,
        "plansurl": "https://example.com/admin/tool/lp/plans.php?userid=3",
        "pluginbaseurl": "https://example.com/blocks/lp",
        "hascompstoreview": true,
        "compstoreview": [
            {
                "usercompetency": {"url": "https://example.com/admin/tool/lp/user_competency.php?id=7", "statusname": "Waiting for review"},
                "competency": {"shortname": "Communicate clearly"},
                "user": {"fullname": "Sam Student"}
            }
        ],
        "hasmorecompstoreview": false,
        "hasplanstoreview": true,
        "planstoreview": [
            {
                "plan": {"url": "https://example.com/admin/tool/lp/plan.php?id=5", "name": "Onboarding", "statusname": "In review"},
                "user": {"fullname": "Robin Learner"}
            }
        ],
        "hasmoreplanstoreview": false
    }
}}
<div class="dim-comp-block">
    {{#hasplans}}
        <h3 class="dim-comp-block__heading">{{#str}}myplans, block_lp{{/str}}</h3>
        <div class="sub-content">
            {{#hasactiveplans}}
                <ul class="dim-comp-block__list">
                    {{#activeplans}}
                        <li class="dim-comp-block__item"><a href="{{url}}">{{{name}}}</a></li>
                    {{/activeplans}}
                    {{#hasmoreplans}}
                        <li class="more dim-comp-block__more"><a href="{{plansurl}}">{{#str}}viewmore, block_lp{{/str}}</a></li>
                    {{/hasmoreplans}}
                </ul>
            {{/hasactiveplans}}
            {{^hasactiveplans}}
                <p class="dim-comp-block__empty">{{#str}}noactiveplans, block_lp{{/str}} <a href="{{plansurl}}">{{#str}}viewotherplans, block_lp{{/str}}</a></p>
            {{/hasactiveplans}}
        </div>
    {{/hasplans}}
    {{#hascompstoreview}}
        <h3 class="dim-comp-block__heading">{{#str}}competenciestoreview, block_lp{{/str}}</h3>
        <div class="sub-content">
            <ul class="dim-comp-block__list">
                {{#compstoreview}}
                    <li class="dim-comp-block__item">
                        <a href="{{usercompetency.url}}">{{{competency.shortname}}}</a>
                        <span class="dim-comp-block__who">{{user.fullname}}</span>
                        <span class="dim-comp-pill dim-comp-pill--status">{{usercompetency.statusname}}</span>
                    </li>
                {{/compstoreview}}
                {{#hasmorecompstoreview}}
                    <li class="more dim-comp-block__more"><a href="{{pluginbaseurl}}/competencies_to_review.php">{{#str}}viewmore, block_lp{{/str}}</a></li>
                {{/hasmorecompstoreview}}
            </ul>
        </div>
    {{/hascompstoreview}}
    {{#hasplanstoreview}}
        <h3 class="dim-comp-block__heading">{{#str}}planstoreview, block_lp{{/str}}</h3>
        <div class="sub-content">
            <ul class="dim-comp-block__list">
                {{#planstoreview}}
                    <li class="dim-comp-block__item">
                        <a href="{{plan.url}}">{{{plan.name}}}</a>
                        <span class="dim-comp-block__who">{{user.fullname}}</span>
                        <span class="dim-comp-pill dim-comp-pill--status">{{plan.statusname}}</span>
                    </li>
                {{/planstoreview}}
                {{#hasmoreplanstoreview}}
                    <li class="more dim-comp-block__more"><a href="{{pluginbaseurl}}/plans_to_review.php">{{#str}}viewmore, block_lp{{/str}}</a></li>
                {{/hasmoreplanstoreview}}
            </ul>
        </div>
    {{/hasplanstoreview}}
</div>
