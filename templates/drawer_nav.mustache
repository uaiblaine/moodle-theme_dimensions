{{!
    @template theme_dimensions/drawer_nav

    The mobile primary drawer of a logged-in account, drawn by this theme's override of
    theme_boost/primary-drawer-mobile from the layout context key dimensionsdrawer, which the core
    renderer writes from theme_dimensions\local\drawernav::context().

    The root panel holds the "Continue where you left off" card and the sections; every sub-panel follows
    it, flat, in the order a parent comes before its children. Without amd/src/drawer.js the panels are
    sections one under the other and every row with children is a link to its panel's anchor, so each
    level stays reachable; the module turns them into sliding panels (inert while hidden, Escape goes back
    one level and closes the drawer at the root, the focus follows) and fills the card from
    theme_dimensions_get_drawer_summary the first time the drawer is shown. The card is shown by the
    stylesheet only once the module has armed the drawer: without it, it would load for ever.

    The drawer holds nothing about the person: the identity, the colour mode, the Look and the language are
    the profile layer's (theme_dimensions/profile_layer). A sub-panel's head is the side layer's sub-view
    header, a back control and the title; Boost's drawer band above it already carries the close button.
    The drawer is a navigation landmark named for the site's navigation. The card is the sparkle ground: its
    tile, its three sparkles and its arrow are decoration, hidden from assistive technology, so the link is
    named by its kicker, its title and its detail.

    Context variables required for this template (described without braces, because a Mustache comment
    closes at the first pair of closing braces it meets):

    * rootid - The root panel's id
    * sections - id, label, items (see theme_dimensions/drawer_item)
    * panels - id, parentid, level, title, backaria, items, hasurl, url, openlabel

    Example context (json):
    {
        "rootid": "dimensions-drawer-panel-root",
        "sections": [
            {
                "id": "dimensions-drawer-section-1",
                "label": "Browse",
                "items": [
                    {
                        "text": "Dashboard",
                        "url": "https://example.com/my/",
                        "icon": "fa fa-gauge",
                        "iscurrent": false,
                        "haschildren": false,
                        "panelid": "",
                        "tooltip": "",
                        "attributes": []
                    },
                    {
                        "text": "My courses",
                        "url": "https://example.com/my/courses.php",
                        "icon": "fa fa-graduation-cap",
                        "iscurrent": true,
                        "haschildren": false,
                        "panelid": "",
                        "tooltip": "",
                        "attributes": []
                    }
                ]
            },
            {
                "id": "dimensions-drawer-section-2",
                "label": "Help",
                "items": [
                    {
                        "text": "Help centre",
                        "url": "#",
                        "icon": "fa fa-circle-dot",
                        "iscurrent": false,
                        "haschildren": true,
                        "panelid": "dimensions-drawer-panel-1",
                        "tooltip": "",
                        "attributes": []
                    }
                ]
            }
        ],
        "panels": [
            {
                "id": "dimensions-drawer-panel-1",
                "parentid": "dimensions-drawer-panel-root",
                "level": 1,
                "title": "Help centre",
                "backaria": "Back to Navigation",
                "items": [
                    {
                        "text": "Frequently asked questions",
                        "url": "https://example.com/faq",
                        "icon": "",
                        "iscurrent": false,
                        "haschildren": false,
                        "panelid": "",
                        "tooltip": "",
                        "attributes": []
                    }
                ],
                "hasurl": true,
                "url": "https://example.com/help",
                "openlabel": "Go to Help centre"
            }
        ]
    }
}}
<nav class="dimensions-drawer" id="dimensions-drawer" data-region="dimensions-drawer" aria-label="{{#str}} drawer_nav, theme_dimensions {{/str}}">
    <div class="dimensions-drawer-viewport">
        <div class="dimensions-drawer-panel" id="{{rootid}}" data-region="dimensions-drawer-panel" data-level="0">
            <div class="dimensions-drawer-resume" data-region="dimensions-drawer-resume" aria-busy="true">
                <a class="dimensions-drawer-resume-link" data-region="dimensions-drawer-resume-link">
                    <svg class="dimensions-drawer-spark dimensions-drawer-spark--a" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2c.6 5.2 4.8 9.4 10 10-5.2.6-9.4 4.8-10 10-.6-5.2-4.8-9.4-10-10 5.2-.6 9.4-4.8 10-10z"/></svg>
                    <svg class="dimensions-drawer-spark dimensions-drawer-spark--b" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2c.6 5.2 4.8 9.4 10 10-5.2.6-9.4 4.8-10 10-.6-5.2-4.8-9.4-10-10 5.2-.6 9.4-4.8 10-10z"/></svg>
                    <svg class="dimensions-drawer-spark dimensions-drawer-spark--c" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2c.6 5.2 4.8 9.4 10 10-5.2.6-9.4 4.8-10 10-.6-5.2-4.8-9.4-10-10 5.2-.6 9.4-4.8 10-10z"/></svg>
                    <span class="dimensions-drawer-resume-tile" aria-hidden="true">
                        <i class="icon fa fa-graduation-cap fa-fw dimensions-drawer-resume-kind dimensions-drawer-resume-kind--course" aria-hidden="true"></i>
                        <i class="icon fa fa-calendar-day fa-fw dimensions-drawer-resume-kind dimensions-drawer-resume-kind--event" aria-hidden="true"></i>
                        <i class="icon fa fa-route fa-fw dimensions-drawer-resume-kind dimensions-drawer-resume-kind--trail" aria-hidden="true"></i>
                    </span>
                    <span class="dimensions-drawer-resume-kicker">{{#str}} drawer_resume, theme_dimensions {{/str}}</span>
                    <span class="dimensions-drawer-resume-title" data-region="dimensions-drawer-resume-title">
                        <span class="visually-hidden">{{#str}} loading, core {{/str}}</span>
                    </span>
                    <span class="dimensions-drawer-resume-sub" data-region="dimensions-drawer-resume-sub"></span>
                    <i class="icon fa fa-arrow-right fa-fw dimensions-drawer-resume-go" aria-hidden="true"></i>
                    <span class="dimensions-drawer-resume-rail" aria-hidden="true">
                        <span class="dimensions-drawer-resume-bar" data-region="dimensions-drawer-resume-bar"></span>
                    </span>
                </a>
            </div>
            {{#sections}}
            <div class="dimensions-drawer-section">
                <p class="dimensions-drawer-label" id="{{id}}">{{label}}</p>
                <ul class="dimensions-drawer-list" aria-labelledby="{{id}}">
                    {{#items}}<li class="dimensions-drawer-row">{{> theme_dimensions/drawer_item }}</li>{{/items}}
                </ul>
            </div>
            {{/sections}}
        </div>
        {{#panels}}
        <div class="dimensions-drawer-panel" id="{{id}}" data-region="dimensions-drawer-panel" data-level="{{level}}" data-parent="{{parentid}}">
            <div class="dimensions-drawer-sub">
                <a class="dimensions-drawer-back" href="#{{parentid}}" data-action="dimensions-drawer-back" aria-label="{{backaria}}">
                    <i class="icon fa fa-chevron-left fa-fw" aria-hidden="true"></i>
                </a>
                <p class="dimensions-drawer-title" id="{{id}}-title">{{title}}</p>
            </div>
            <ul class="dimensions-drawer-list" aria-labelledby="{{id}}-title">
                {{#items}}<li class="dimensions-drawer-row">{{> theme_dimensions/drawer_item }}</li>{{/items}}
            </ul>
            {{#hasurl}}
            <a class="dimensions-drawer-openparent" href="{{{url}}}">{{openlabel}}</a>
            {{/hasurl}}
        </div>
        {{/panels}}
    </div>
</nav>
{{#js}}
require(['theme_dimensions/drawer'], function(Drawer) {
    Drawer.init('dimensions-drawer');
});
{{/js}}
