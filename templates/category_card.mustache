}}
<article class="dim-card{{#ismuted}} dim-card--muted{{/ismuted}}" data-region="dim-card" data-courseid="{{id}}" data-state="{{state}}" data-chip="{{chip}}" data-fields="{{fieldvalues}}"{{#hasstartday}} data-start="{{startday}}"{{/hasstartday}}>
    <div class="dim-card__media{{#hasimage}} dim-card__media--image{{/hasimage}}">
        {{#hasimage}}
        <img class="dim-card__image" src="{{imageurl}}" alt="" loading="lazy" decoding="async" width="320" height="150">
        {{/hasimage}}
        {{#datetile}}
        <span class="dim-card__datetile"><b>{{day}}</b><span>{{month}}</span></span>
        {{/datetile}}
        {{#haskind}}
        <span class="dim-card__kind{{#isevent}} dim-card__kind--event{{/isevent}}"><i class="fa {{#isevent}}fa-calendar-day{{/isevent}}{{^isevent}}fa-graduation-cap{{/isevent}}" aria-hidden="true"></i><span class="dim-card__kindlabel">{{kindlabel}}</span></span>
        {{/haskind}}
    </div>
    <div class="dim-card__body">
        <div class="dim-card__titlewrap">
            {{#hasoverline}}
            <span class="dim-card__over">{{overline}}</span>
            {{/hasoverline}}
            <h3 class="dim-card__title" data-region="dim-card-title">{{#hasurl}}<a href="{{url}}" title="{{fullname}}" data-region="dim-card-titlelink">{{fullname}}</a>{{/hasurl}}{{^hasurl}}<span title="{{fullname}}">{{fullname}}</span>{{/hasurl}}</h3>
            {{#meta}}
            <p class="dim-card__meta">{{meta}}</p>
            {{/meta}}
        </div>
        <div class="dim-card__row">
            {{#hasbadges}}
            <ul class="dim-card__crests" role="list" aria-label="{{badgeslabel}}" data-region="dim-card-crests">
                {{#badges}}
                <li class="dim-card__crest"><img src="{{url}}" alt="{{alt}}" loading="lazy"></li>
                {{/badges}}
            </ul>
            {{/hasbadges}}
            <span class="dim-card__badge {{badge.classes}}"><i class="fa {{badge.icon}}" aria-hidden="true"></i> {{badge.label}}</span>
            {{#ishidden}}
            <span class="dim-card__badge {{hiddenbadge.classes}}"><i class="fa fa-eye-slash" aria-hidden="true"></i> {{hiddenbadge.label}}</span>
            {{/ishidden}}
            <span class="dim-card__prog" data-region="dim-card-progress" hidden></span>
        </div>
        {{#hasroute}}
        <p class="dim-card__route"><i class="fa fa-arrow-right" aria-hidden="true"></i> {{routelabel}}</p>
        {{/hasroute}}
        {{#hasopens}}
        <p class="dim-card__opens" data-region="dim-card-opens"><i class="fa fa-calendar-plus" aria-hidden="true"></i> {{openslabel}}</p>
        {{/hasopens}}
        <div class="dim-card__actions">
            {{#cta}}
            <a class="btn btn-sm dim-card__cta {{#primary}}btn-primary{{/primary}}{{^primary}}btn-outline-primary{{/primary}}" href="{{url}}">{{label}}</a>
            {{/cta}}
            <details class="dim-card__details" id="{{detailsid}}" data-region="dim-card-details">
                <summary class="btn btn-sm dim-card__summary">{{detailslabel}}</summary>
                <div class="dim-card__panel" data-region="dim-card-panel">
                    <h4 class="dim-card__paneltitle">{{fullname}}</h4>
                    {{#hasexcerpt}}
                    <p class="dim-card__excerpt">{{excerpt}}</p>
                    {{/hasexcerpt}}
                    {{#hasfacts}}
                    <ul class="dim-card__facts">
                        {{#facts}}
                        <li><span class="dim-card__factlabel">{{label}}:</span> <b>{{value}}</b></li>
                        {{/facts}}
                    </ul>
                    {{/hasfacts}}
                    {{#haslearn}}
                    <p class="dim-card__learnlabel">{{learnlabel}}</p>
                    <ul class="dim-card__learn">
                        {{#learn}}
                        <li><i class="fa fa-check" aria-hidden="true"></i> {{.}}</li>
                        {{/learn}}
                    </ul>
                    {{/haslearn}}
                </div>
            </details>
            {{#showstar}}
            <button type="button" class="dim-card__star dim-js-only" aria-pressed="{{#favourite}}true{{/favourite}}{{^favourite}}false{{/favourite}}" data-action="dim-star" data-courseid="{{id}}" data-star-add="{{starlabeladd}}" data-star-remove="{{starlabelremove}}"><i class="{{#favourite}}fa-solid{{/favourite}}{{^favourite}}fa-regular{{/favourite}} fa-star" aria-hidden="true"></i><span class="visually-hidden" data-region="dim-star-label">{{starlabel}}</span></button>
            {{/showstar}}
        </div>
    </div>
    <template data-region="dim-card-modal">
        {{> theme_dimensions/category_card_modal }}
    </template>
</article>
